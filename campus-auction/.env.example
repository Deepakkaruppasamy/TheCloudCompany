# Campus Auction App — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# ── Supabase (public) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://orovkmsuacamgucuuwmc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (server-only — never prefix with NEXT_PUBLIC_) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Demo / Production mode ──────────────────────────────────────────────────
# Set to "true" for demo project, "false" for production.
DEMO_MODE=true

# Production only (required when DEMO_MODE=false, must be unset when DEMO_MODE=true)
# SELLER_RESPONSE_HOURS=24
# PICKUP_HOURS=48

# Demo only (required when DEMO_MODE=true, must be unset when DEMO_MODE=false)
SELLER_RESPONSE_MINUTES=3
PICKUP_MINUTES=5

# ── Reconcile endpoint ───────────────────────────────────────────────────────
# Minimum 32 random bytes, base64url-encoded.
RECONCILE_SECRET=replace-with-at-least-32-bytes-of-random-base64url

# ── Database (test and seed tooling only — never expose to browser) ──────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Demo accounts (seed-demo.ts only) ───────────────────────────────────────
DEMO_SELLER_1_EMAIL=seller1@demo.campus
DEMO_SELLER_1_PASSWORD=changeme-seller1
DEMO_SELLER_2_EMAIL=seller2@demo.campus
DEMO_SELLER_2_PASSWORD=changeme-seller2
DEMO_BIDDER_1_EMAIL=bidder1@demo.campus
DEMO_BIDDER_1_PASSWORD=changeme-bidder1
DEMO_BIDDER_2_EMAIL=bidder2@demo.campus
DEMO_BIDDER_2_PASSWORD=changeme-bidder2
